generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(DEVELOPER)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  managedProjects Project[]      @relation("ProjectManager")
  assignedTasks   Task[]         @relation("AssignedDeveloper")
  activityLogs    ActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([email])
}

model Client {
  id           String    @id @default(uuid())
  name         String
  contactEmail String
  contactPhone String?
  company      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects Project[]

  @@index([name])
}

model Project {
  id               String   @id @default(uuid())
  name             String
  description      String
  clientId         String
  projectManagerId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectManager User          @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  tasks          Task[]
  activityLogs   ActivityLog[]
  notifications  Notification[]

  @@index([projectManagerId])
  @@index([clientId])
  @@index([createdAt])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  title       String
  description String
  developerId String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime
  isOverdue   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developer     User?          @relation("AssignedDeveloper", fields: [developerId], references: [id], onDelete: SetNull)
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([projectId])
  @@index([developerId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([developerId, status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  taskId    String?
  actorId   String
  action    String
  oldValue  String?
  newValue  String?
  message   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id               String    @id @default(uuid())
  recipientId      String
  type             String
  title            String
  message          String
  relatedProjectId String?
  relatedTaskId    String?
  isRead           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  readAt           DateTime?

  recipient      User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  relatedProject Project? @relation(fields: [relatedProjectId], references: [id], onDelete: Cascade)
  relatedTask    Task?    @relation(fields: [relatedTaskId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
